@startuml Gaza_Kid_Mind_Canvas_ERD

!define primary_key(x) <b>x</b>
!define foreign_key(x) <u>x</u>
!define unique(x) <i>x</i>

entity "USER" as user {
  primary_key(_id): ObjectId
  --
  unique(email): String
  password: String
  institutionName: String
  averageChildren: Number
  licenseNumber: String
  address: String
  contactNumber: String
  logo: String
  openaiConfig: Object
  isActive: Boolean
  role: String [admin|user]
  createdAt: Date
  updatedAt: Date
}

entity "CHILD" as child {
  primary_key(_id): ObjectId
  --
  foreign_key(user): ObjectId
  name: String
  age: Number [1-18]
  gender: String [male|female]
  group: String
  favoriteColor: String
  profileImage: String
  additionalInfo: Object
  emotionalStatus: Object
  psychologicalIndicators: Object
  isActive: Boolean
  createdAt: Date
  updatedAt: Date
}

entity "DRAWING" as drawing {
  primary_key(_id): ObjectId
  --
  foreign_key(child): ObjectId
  foreign_key(user): ObjectId
  imageUrl: String
  title: String
  description: String
  analysis: Object
  context: Object
  tags: Array<String>
  isAnalyzed: Boolean
  analyzedAt: Date
  status: String [pending|analyzing|completed|failed]
  error: String
  createdAt: Date
  updatedAt: Date
}

entity "RECOMMENDATION" as recommendation {
  primary_key(_id): ObjectId
  --
  foreign_key(child): ObjectId
  foreign_key(user): ObjectId
  title: String
  description: String
  category: String [therapeutic|educational|behavioral|social|family]
  priority: String [high|medium|low]
  type: String [positive|warning|action]
  foreign_key(basedOnDrawings): Array<ObjectId>
  drawingSummaries: Array<Object>
  generationMetadata: Object
  isActive: Boolean
  createdAt: Date
  updatedAt: Date
}

' Relationships
user ||--o{ child : manages
user ||--o{ drawing : creates
user ||--o{ recommendation : generates

child ||--o{ drawing : has
child ||--o{ recommendation : receives

drawing }o--o{ recommendation : informs

' Notes about embedded objects
note right of child
  **additionalInfo contains:**
  - medicalHistory
  - familyBackground
  - previousAssessments
  - notes
  
  **emotionalStatus contains:**
  - happiness (0-100)
  - sadness (0-100)
  - anger (0-100)
  - fear (0-100)
  - anxiety (0-100)
  
  **psychologicalIndicators contains:**
  - selfConfidence (0-100)
  - socialInteraction (0-100)
  - emotionalExpression (0-100)
  - adaptability (0-100)
  - cognitiveAbility (0-100)
end note

note right of drawing
  **analysis contains:**
  - aiAnalysis (Object)
  - psychologicalState (Object)
  - professionalNotes (String)
  - recommendations (Array)
  - confidenceScore (0-100)
  
  **context contains:**
  - environment
  - mood
  - activity
  - sessionNotes
end note

note right of recommendation
  **generationMetadata contains:**
  - totalDrawingsAnalyzed
  - generatedAt
  - modelUsed
  
  **drawingSummaries contains:**
  - drawingId
  - drawingTitle
  - drawingDate
  - summary
  - status
end note

@enduml